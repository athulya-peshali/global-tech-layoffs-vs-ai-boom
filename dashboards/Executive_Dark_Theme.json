{
  "name": "IdentyFlow Dark SaaS",
  "dataColors": [
    "#FF4D4D",
    "#00F2FE",
    "#3B82F6",
    "#A855F7",
    "#10B981",
    "#F59E0B"
  ],
  "background": "#0A0E17",
  "foreground": "#FFFFFF",
  "tableAccent": "#131B2E",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#131B2E" } },
